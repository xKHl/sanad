# Mode: cloud | local | demo  (default: cloud if a provider key is set, otherwise demo)
SANAD_MODE=

# Cloud provider: google (free tier) | groq (free tier) | anthropic | openai | gateway
LLM_PROVIDER=google
# Leave empty to use the provider default (google: gemini-3.8-flash, groq: openai/gpt-oss-120b)
LLM_MODEL=

# Free: create a key at https://aistudio.google.com (no credit card)
GOOGLE_GENERATIVE_AI_API_KEY=
# Free: create a key at https://console.groq.com (no credit card)
GROQ_API_KEY=
# Paid options
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Local (Ollama, OpenAI-compatible endpoint). Set SANAD_MODE=local and LLM_MODEL=<installed model>
OLLAMA_BASE_URL=http://localhost:11434/v1

# Requests per minute per IP for /api/analyze (0 disables)
RATE_LIMIT_PER_MINUTE=8

# Set to true to enable the /lab page (run the evaluation and record demo outputs from the browser).
# SANAD_LAB_KEY must then be set to a secret of at least 8 characters; the page asks for it.
SANAD_LAB=false
SANAD_LAB_KEY=
